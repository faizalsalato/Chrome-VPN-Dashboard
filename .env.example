DOMAIN=brave.rota.ath.cx
# Porta do painel (é para cá que o vhost raiz do nginx aponta).
PORT=3001
# Porta base das INSTÂNCIAS: a de ordem N usa BASE_PORT+N (4001, 4002…).
BASE_PORT=4001
MAX_INSTANCES=20
JWT_SECRET=change-this-secret
SESSION_EXPIRY=86400
ADMIN_USER=admin
ADMIN_PASS=admin123
CERTBOT_EMAIL=admin@brave.rota.ath.cx
# Porta base dos forwarders locais de proxy autenticado (um por instância: BASE+id)
PROXY_INJECTOR_BASE_PORT=8100

# Navegador antidetect (CloakBrowser). O binário lança o Chrome no X do
# container (o KasmVNC, instalado pela imagem derivada, ver
# deploy/browser-image/Dockerfile) com as flags de fingerprint.
#
# O DevTools fica preso no loopback (127.0.0.1:9222) e a TELA do KasmVNC também
# (127.0.0.1:9225). Quem expõe os dois numa porta só é o roteador embutido no
# comando do container (src/browser/port-router.py): ele escuta em 0.0.0.0:9223
# e separa por caminho — `/json`, `/devtools` e `/fingerprint` vão para o
# DevTools, `/audio` para a ponte de áudio e todo o resto é a tela. 9223 é a
# porta publicada e a que o vhost do nginx encaminha.
CLOAKBROWSER_IMAGE=cloakhq/cloakbrowser:latest
# Imagem derivada (KasmVNC + áudio) que o dashboard constrói a partir da de cima.
BROWSER_IMAGE=chrome-vpn-dashboard-browser:latest
# A chave NÃO vem daqui: cada instância recebe uma da biblioteca (menu "Chaves
# CloakBrowser"). Sem chave, o binário roda no modo grátis (1 sessão por vez).
# Baixa o Widevine dentro do container (só quando o perfil precisar de DRM)
CLOAKBROWSER_FETCH_WIDEVINE=
# Porta do cliente web do KasmVNC DENTRO do container (loopback; quem publica é
# o roteador). Só mude se 9225 conflitar com algo do seu perfil.
KASM_PORT=9225
# Áudio do container: taxa e canais do PCM que vai para o cliente web
# (24000 x 1 canal ≈ 48 kB/s). A ponte está em deploy/browser-image/audio-bridge.py.
AUDIO_RATE=24000
AUDIO_CHANNELS=1
# Envio de ficheiros para o perfil (botão ⬆ Enviar): 0 = SEM teto — o limite
# passa a ser o espaço em disco do servidor.
MAX_UPLOAD_BYTES=0
# Esconde o infobar amarelo "You are using an unsupported command-line flag:
# --no-sandbox" adicionando --test-type ao lançamento do Chrome. Só ligue se
# aceitar o trade-off: o --test-type marca o browser como "modo de teste", o que
# alguns logins (Google) e detectores de anti-bot conseguem notar. Sem isso o
# aviso continua (é cosmético; fecha-se com um clique). Neste servidor o
# --no-sandbox é obrigatório (root + AppArmor sem user namespaces), por isso a
# flag não pode ser removida — apenas mascarada.
CLOAKBROWSER_TEST_TYPE=
